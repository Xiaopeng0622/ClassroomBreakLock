<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         ClassIsland 风格设计令牌（Fluent / WinUI 取向）
         参照：ClassIsland 界面 —— 无重边框、无投影、大留白、
               药丸形信息条、天依蓝强调色
         ============================================================ -->

    <!-- ===== 颜色 ===== -->
    <!-- 浅色（设置窗口） -->
    <Color x:Key="CLayer0">#F3F3F3</Color>   <!-- 窗口底（Mica 近似） -->
    <Color x:Key="CLayer1">#FFFFFF</Color>   <!-- 卡片 -->
    <Color x:Key="CLayer2">#F9F9F9</Color>   <!-- 卡片内次级面 -->
    <Color x:Key="CStroke">#E5E5E5</Color>   <!-- 分隔/描边（极浅） -->
    <Color x:Key="CStrokeSoft">#EBEBEB</Color>
    <Color x:Key="CInk">#1B1B1B</Color>      <!-- 主文字 -->
    <Color x:Key="CInk2">#5D5D5D</Color>     <!-- 次要文字 -->
    <Color x:Key="CInk3">#8A8A8A</Color>     <!-- 弱文字 -->
    <Color x:Key="CAccent">#0067C0</Color>   <!-- 强调色（Win11 蓝） -->
    <Color x:Key="CAccentHover">#1975C5</Color>
    <Color x:Key="CAccentSoft">#EFF6FC</Color>
    <Color x:Key="CDanger">#C42B1C</Color>
    <Color x:Key="CDangerSoft">#FDF3F2</Color>
    <Color x:Key="CWarn">#9D5D00</Color>
    <Color x:Key="CWarnBg">#FFF9F0</Color>
    <Color x:Key="COk">#0F7B0F</Color>

    <!-- 深色（锁屏页 / 深色面） -->
    <Color x:Key="CDarkBg">#0F1115</Color>
    <Color x:Key="CDarkSurface">#1B1D22</Color>
    <Color x:Key="CDarkSurface2">#26282E</Color>
    <Color x:Key="CDarkStroke">#2E3138</Color>
    <Color x:Key="CDarkInk">#F2F4F7</Color>
    <Color x:Key="CDarkInk2">#A5ACB8</Color>
    <Color x:Key="CDarkInk3">#767D89</Color>

    <SolidColorBrush x:Key="Layer0Brush" Color="{StaticResource CLayer0}"/>
    <SolidColorBrush x:Key="Layer1Brush" Color="{StaticResource CLayer1}"/>
    <SolidColorBrush x:Key="Layer2Brush" Color="{StaticResource CLayer2}"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource CStroke}"/>
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource CStrokeSoft}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource CInk}"/>
    <SolidColorBrush x:Key="Ink2Brush" Color="{StaticResource CInk2}"/>
    <SolidColorBrush x:Key="Ink3Brush" Color="{StaticResource CInk3}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CAccent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource CAccentHover}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource CAccentSoft}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource CDanger}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource CDangerSoft}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource CWarn}"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource CWarnBg}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource COk}"/>

    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource CDarkBg}"/>
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource CDarkSurface}"/>
    <SolidColorBrush x:Key="DarkSurface2Brush" Color="{StaticResource CDarkSurface2}"/>
    <SolidColorBrush x:Key="DarkStrokeBrush" Color="{StaticResource CDarkStroke}"/>
    <SolidColorBrush x:Key="DarkInkBrush" Color="{StaticResource CDarkInk}"/>
    <SolidColorBrush x:Key="DarkInk2Brush" Color="{StaticResource CDarkInk2}"/>
    <SolidColorBrush x:Key="DarkInk3Brush" Color="{StaticResource CDarkInk3}"/>

    <!-- 半透明面（无边框风格的"面"） -->
    <SolidColorBrush x:Key="HoverBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="DarkHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="DarkChipBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#140067C0"/>

    <!-- ===== 天依蓝强调渐变（用于关键按钮/图标底） ===== -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66CCFF" Offset="0"/>
        <GradientStop Color="#2E90D9" Offset="1"/>
    </LinearGradientBrush>

    <!--
        ===== 粉色渐变（锁屏左上角「课间锁定」芯片专用） =====
        单独开一个令牌而不是改 AccentGradient——后者被悬浮按钮、主按钮等多处共用，
        直接改会波及全站配色。
        色相沿用天依蓝的明度节奏，换成樱粉一系，在深色锁屏底上对比度足够。
    -->
    <LinearGradientBrush x:Key="AccentGradientPink" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9EC4" Offset="0"/>
        <GradientStop Color="#E8517F" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 锁屏页背景（ClassIsland 深色 + 天依蓝光晕） ===== -->
    <LinearGradientBrush x:Key="LockBackdrop" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#141A26" Offset="0"/>
        <GradientStop Color="#0B0D12" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="LockGlow" GradientOrigin="0.2,0.12" Center="0.2,0.12"
                         RadiusX="0.8" RadiusY="0.9">
        <GradientStop Color="#332E90D9" Offset="0"/>
        <GradientStop Color="#002E90D9" Offset="1"/>
    </RadialGradientBrush>

    <!-- ===== 圆角（Fluent 尺度，不再是 22px 大圆角） ===== -->
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <FontFamily x:Key="UIFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, monospace</FontFamily>

    <!-- ===== 缓动 ===== -->
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

</ResourceDictionary>
