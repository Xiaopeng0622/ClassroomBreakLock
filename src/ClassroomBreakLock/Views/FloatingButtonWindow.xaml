<Window x:Class="ClassroomBreakLock.Views.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下课"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/CI.Lock.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 气泡在上、按钮在下：气泡向上长，按钮位置永远不动 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 提示气泡：深色实心 + 细边，宽度自适应并自动换行（不再被截断） -->
        <Border x:Name="Bubble" Grid.Row="0"
                CornerRadius="{StaticResource RadiusCard}"
                Padding="12,8" Margin="0,0,0,10"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                Background="{StaticResource DarkSurfaceBrush}"
                BorderBrush="{StaticResource DarkStrokeBrush}" BorderThickness="1">
            <TextBlock x:Name="BubbleText" Foreground="{StaticResource DarkInkBrush}"
                       FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>
        </Border>

        <!-- 圆形“下课”按钮：天依蓝渐变，无外框。右对齐，这样窗口加宽时按钮不会移动 -->
        <Button x:Name="MainButton"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Width="{Binding ButtonSize}" Height="{Binding ButtonSize}"
                Cursor="Hand"
                Click="OnClick"
                MouseLeftButtonDown="OnDragStart"
                MouseMove="OnDragMove"
                MouseLeftButtonUp="OnDragEnd"
                ToolTip="点击表示本节课结束，进入课间">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Margin="2" Fill="{StaticResource AccentGradient}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <StackPanel>
                <TextBlock x:Name="ButtonText" Text="下课" FontSize="20" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ButtonSubText" Text="" FontSize="11" Foreground="#DCEBFA"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
