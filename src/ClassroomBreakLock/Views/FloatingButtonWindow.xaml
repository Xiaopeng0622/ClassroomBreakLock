<Window x:Class="ClassroomBreakLock.Views.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下课"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/CI.Lock.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 气泡在上、按钮在下：气泡向上长，按钮位置永远不动 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 提示气泡：深色实心 + 细边，宽度自适应并自动换行（不再被截断） -->
        <Border x:Name="Bubble" Grid.Row="0"
                CornerRadius="{StaticResource RadiusCard}"
                Padding="12,8" Margin="0,0,0,10"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                Background="{StaticResource DarkSurfaceBrush}"
                BorderBrush="{StaticResource DarkStrokeBrush}" BorderThickness="1">
            <TextBlock x:Name="BubbleText" Foreground="{StaticResource DarkInkBrush}"
                       FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>
        </Border>

        <!--
            圆形“下课”按钮：天依蓝渐变，无外框。右对齐，这样窗口加宽时按钮不会移动。
            注意：尺寸**不在这里绑定**——由 ApplyVisualState() 按展开/缩起状态直接赋值。

            拖动相关事件用 **Preview**（隧道）版本：
              WPF 的 Button 会在冒泡阶段把 MouseLeftButtonDown 转成自己的 Click 逻辑并
              标记 Handled，导致挂在 Button 上的普通 MouseLeftButtonDown 收不到
              （实测：Win32 的 WM_LBUTTONDOWN 到达了，但 OnDragStart 从未执行）。
              Preview 事件从根向下传递，在 Button 处理之前就先拿到，稳定可靠。
        -->
        <Button x:Name="MainButton"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Cursor="Hand"
                Click="OnClick"
                PreviewMouseLeftButtonDown="OnDragStart"
                PreviewMouseMove="OnDragMove"
                PreviewMouseLeftButtonUp="OnDragEnd"
                ToolTip="点击后确认下课，随即锁定多媒体">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Margin="2" Fill="{StaticResource AccentGradient}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <Grid>
                <StackPanel x:Name="ButtonContent">
                    <TextBlock x:Name="ButtonText" Text="下课" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ButtonSubText" Text="" FontSize="11" Foreground="#DCEBFA"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 缩起状态下的居中圆点（表示"点我展开"） -->
                <Ellipse x:Name="CollapsedDot" Width="7" Height="7" Fill="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="Collapsed"/>
            </Grid>
        </Button>
    </Grid>
</Window>
