<Window x:Class="ClassroomBreakLock.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课间锁屏"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        Background="#0B0D12"
        Foreground="#F2F4F7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Closing="OnClosing"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/CI.Lock.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- ===== 背景：三层叠加 =====
             1) 内置深色渐变（始终在，作为兜底）
             2) 自定义背景图（可开关，带模糊与不透明度）
             3) 遮罩层（压暗，保证浅色图上白字可读）
             4) 天依蓝光晕（装饰）
        -->

        <!-- 1) 内置深色底 -->
        <Rectangle Fill="{StaticResource LockBackdrop}"/>

        <!-- 2) 自定义背景图（未启用时整层隐藏） -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill"
               Visibility="Collapsed" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
                <!-- 模糊半径由代码按配置设置；为 0 时整个 Effect 会被移除 -->
                <BlurEffect x:Name="BackgroundBlur" Radius="0"
                            KernelType="Gaussian" RenderingBias="Performance"/>
            </Image.Effect>
        </Image>

        <!-- 3) 遮罩：压暗背景图，保证前景文字对比度 -->
        <Rectangle x:Name="BackgroundOverlay" Fill="#000000" Opacity="0"
                   IsHitTestVisible="False"/>

        <!-- 4) 天依蓝光晕 -->
        <Rectangle Fill="{StaticResource LockGlow}" IsHitTestVisible="False"/>

        <Grid Margin="72,52,72,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 顶部：状态芯片 + 教室名 / 时钟 ===== -->
            <Grid Grid.Row="0">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentGradientPink}"
                                CornerRadius="{StaticResource RadiusControl}" Padding="14,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="🌸 课间锁定" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="ClassroomText" Text="教室" FontSize="14"
                                   Foreground="{StaticResource DarkInk2Brush}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 每日一言（原先这里是个永远显示"状态加载中…"的死控件） -->
                    <TextBlock x:Name="DailyQuoteText" Text="" Style="{StaticResource LockSub}"
                               FontSize="13.5" Margin="0,14,0,0" MaxWidth="700"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="52" FontWeight="Light"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource DarkInkBrush}"/>
                    <TextBlock x:Name="DateText" Text="" FontSize="14"
                               Foreground="{StaticResource DarkInk3Brush}"
                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ===== 中部：整块居中（对称布局，观感更稳） ===== -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="760">
                <TextBlock x:Name="TitleText" Text="课间休息，多媒体已锁定"
                           Style="{StaticResource LockTitle}" TextAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" Text="请插入钥匙 U 盘，或使用其它方式解锁"
                           Style="{StaticResource LockSub}" TextAlignment="Center" Margin="0,12,0,0"/>

                <!-- 认证方式切换（芯片行整体居中） -->
                <StackPanel x:Name="TabBar" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,30,0,0"/>

                <!-- U 盘 -->
                <StackPanel x:Name="PanelUsb" Margin="0,14,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="插入已登记的钥匙 U 盘后，点击下方按钮校验"
                               Style="{StaticResource LockSub}" TextAlignment="Center"/>
                    <TextBlock x:Name="UsbHintText" Text="" Style="{StaticResource LockWarn}"
                               TextAlignment="Center" Margin="0,10,0,0"/>
                    <Button x:Name="UsbBtn" Content="检测 U 盘并解锁"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="0,22,0,0" Width="264" HorizontalAlignment="Center"
                            Click="OnUsbClick"/>
                </StackPanel>

                <!-- 密码 -->
                <StackPanel x:Name="PanelPassword" Visibility="Collapsed" Margin="0,14,0,0"
                            HorizontalAlignment="Center">
                    <PasswordBox x:Name="PwdBox" Style="{StaticResource FieldPassword}"
                                 Width="340" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PwdHintText" Text="" Style="{StaticResource LockSub}"
                               FontSize="13.5" TextAlignment="Center" Margin="0,12,0,0"/>
                    <Button x:Name="PwdBtn" Content="解锁" Style="{StaticResource PrimaryBtn}"
                            Margin="0,22,0,0" Width="264" HorizontalAlignment="Center"
                            Click="OnPwdClick"/>
                </StackPanel>

                <!-- TOTP -->
                <StackPanel x:Name="PanelTotp" Visibility="Collapsed" Margin="0,14,0,0"
                            HorizontalAlignment="Center">
                    <TextBox x:Name="TotpBox" Style="{StaticResource FieldBox}" MaxLength="6"
                             FontSize="26" HorizontalContentAlignment="Center" Width="300"
                             HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotpTimerText" Text="" Style="{StaticResource LockSub}"
                               FontSize="13.5" TextAlignment="Center" Margin="0,12,0,0"/>
                    <Button x:Name="TotpBtn" Content="验证动态码"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="0,22,0,0" Width="264" HorizontalAlignment="Center"
                            Click="OnTotpClick"/>
                </StackPanel>

                <!-- 应急码 -->
                <StackPanel x:Name="PanelEmergency" Visibility="Collapsed" Margin="0,14,0,0"
                            HorizontalAlignment="Center">
                    <TextBox x:Name="EmergencyBox" Style="{StaticResource FieldBox}" Width="320"
                             HorizontalAlignment="Center" MaxLength="20"/>
                    <TextBlock Text="应急码仅供管理员在忘带 U 盘时使用，使用后自动作废并留痕"
                               Style="{StaticResource LockSub}" FontSize="13.5"
                               TextAlignment="Center" Margin="0,12,0,0"/>
                    <Button x:Name="EmergencyBtn" Content="提交应急码"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="0,22,0,0" Width="264" HorizontalAlignment="Center"
                            Click="OnEmergencyClick"/>
                </StackPanel>

                <TextBlock x:Name="MessageText" Text="" Style="{StaticResource LockError}"
                           TextAlignment="Center" Margin="0,20,0,0"/>

                <Button x:Name="SettingsBtn" Content="进入设置（需认证）"
                        Style="{StaticResource GhostBtn}" Width="264"
                        HorizontalAlignment="Center" Margin="0,28,0,0" Click="OnSettingsClick"/>
            </StackPanel>

            <!-- ===== 底部提示 ===== -->
            <TextBlock Grid.Row="2" x:Name="FooterText" Style="{StaticResource LockFaint}"/>
        </Grid>
    </Grid>
</Window>
